# Pasta base dos dados (padrao: ./data). No Docker, o compose ja define /app/data.
# CNPJ_DATA_DIR=./data

# Template da URL dos arquivos. Placeholders: {month} (AAAA-MM) e {filename}.
# Confirme o caminho atual no site da Receita Federal antes de usar: o layout da
# pagina e o caminho dos arquivos mudaram no inicio de 2026.
# CNPJ_URL_TEMPLATE=https://arquivos.receitafederal.gov.br/public.php/webdav/Dados/Cadastros/CNPJ/{month}/{filename}

# Token do compartilhamento publico (WebDAV). Nao e segredo, mas pode mudar.
# CNPJ_SHARE_TOKEN=gn672Ad4CF8N6TK

# Numero de partes das tabelas divididas (Empresas0..N-1, Estabelecimentos0..N-1, Socios0..N-1)
# CNPJ_PARTS=10

# Nuvem (AWS), usado por python -m cnpj_pipeline.cloud.publish e .athena
# Nunca coloque chaves de acesso aqui: use perfis do AWS CLI (aws configure --profile cnpj-publisher).
# CNPJ_S3_BUCKET=
# CNPJ_AWS_PROFILE=cnpj-publisher
# CNPJ_AWS_REGION=us-east-1

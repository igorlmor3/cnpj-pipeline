# Copie para terraform.tfvars (que nao e versionado) e ajuste os valores.
bucket_name = "cnpj-pipeline-SEU-NOME-2026"
alert_email = "seu-email@exemplo.com"

# Opcionais (valores padrao abaixo)
# region                        = "us-east-1"
# profile                       = "cnpj-admin"
# monthly_budget_usd            = 5
# athena_scan_limit_gb          = 5
# athena_results_retention_days = 7

# API publica do agente (veja infra/README.md). Gere antes o pacote:
#   python -m cnpj_pipeline.api.package --month 2026-10
# api_enabled         = true
# api_month           = "2026-10"
# api_months          = ["2026-07", "2026-08", "2026-09", "2026-10"]
# api_allowed_origins = ["https://seu-usuario.github.io"]

# Nivel 2: o pipeline em uma tarefa do ECS Fargate (veja infra/README.md)
# ecs_enabled               = true
# ecs_vcpu                  = 4
# ecs_memory_mib            = 16384
# ecs_ephemeral_storage_gib = 120
# ecs_task_timeout_minutes  = 300

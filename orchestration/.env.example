# Copie para .env nesta pasta (o .env nao e versionado). Todos os valores sao opcionais.

# Versao do Airflow (a imagem e construida a partir de apache/airflow:<versao>)
# AIRFLOW_VERSION=3.4.0

# Segredos da API do Airflow. Os padroes do compose servem so para a propria maquina.
# AIRFLOW_JWT_SECRET=
# AIRFLOW_API_SECRET_KEY=

# Publicacao na AWS (tarefas publicar_s3 e tabelas_athena, com publish=true no modo full)
# CNPJ_S3_BUCKET=
# CNPJ_AWS_PROFILE=cnpj-publisher
# CNPJ_AWS_REGION=us-east-1
